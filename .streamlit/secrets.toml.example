# .streamlit/secrets.toml 로 복사한 뒤 실제 값을 넣으세요. (이 파일은 GitHub에 올리지 마세요)

# Supabase → Project Settings → API
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "YOUR_SERVICE_ROLE_KEY"

# 최초 관리자 계정. 관리자가 하나도 없을 때 이 값으로 만들어지며, 첫 로그인 때 비밀번호를 바꿔야 합니다.
# 예전 버전의 '1 / 1' 관리자를 쓰고 있었다면 INITIAL_ADMIN_ID = "1" 로 두고 앱을 재시작하면
# 그 계정의 비밀번호가 아래 값으로 재설정됩니다.
INITIAL_ADMIN_ID = "admin"
INITIAL_ADMIN_PASSWORD = "CHANGE-ME-strong-password"
